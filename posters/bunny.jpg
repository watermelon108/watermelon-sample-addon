  <ellipse cx="590" cy="190" rx="10" ry="80" fill="#ffc2d1"/>
  <!-- front legs -->
  <rect x="500" y="440" width="26" height="60" rx="13" fill="#eaeaea" stroke="#bbbbbb" stroke-width="3"/>
  <rect x="540" y="440" width="26" height="60" rx="13" fill="#eaeaea" stroke="#bbbbbb" stroke-width="3"/>
  <!-- face -->
  <circle cx="540" cy="320" r="8" fill="#222"/>
  <circle cx="545" cy="317" r="3" fill="#fff"/>
  <ellipse cx="588" cy="345" rx="9" ry="7" fill="#ff8fa3"/>
